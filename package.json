{
  "name": "glint-and-thread",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "copy-images": "tsx scripts/copy-catalog-images.ts",
    "predev": "npm run copy-images",
    "dev": "next dev",
    "prebuild": "npm run copy-images",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "next typegen && tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "e2e": "playwright test",
    "shots": "tsx scripts/screenshots.ts",
    "seed": "tsx scripts/seed-sanity.ts",
    "seed:dry": "tsx scripts/seed-sanity.ts --dry-run",
    "typegen": "node -e \"require('fs').rmSync('sanity/extract.json',{force:true})\" && sanity schema extract --path=sanity/extract.json && sanity typegen generate",
    "check:launch": "tsx scripts/check-launch.ts",
    "ci": "npm run typecheck && npm run lint && npm run test"
  },
  "dependencies": {
    "@portabletext/react": "^8.0.1",
    "@portabletext/types": "^4.0.2",
    "@radix-ui/react-accordion": "^1.2.21",
    "@radix-ui/react-dialog": "^1.2.0",
    "@radix-ui/react-navigation-menu": "^1.3.0",
    "@radix-ui/react-slot": "^1.4.0",
    "@radix-ui/react-visually-hidden": "^1.2.12",
    "@react-email/components": "^1.0.12",
    "@react-email/render": "^2.1.0",
    "@sanity/client": "^8.9.0",
    "@sanity/image-url": "^2.1.1",
    "@sanity/ui": "^4.4.0",
    "@sanity/vision": "^6.18.0",
    "@vercel/analytics": "^2.0.1",
    "groq": "^6.18.0",
    "lucide-react": "^1.55.0",
    "motion": "^14.1.0",
    "next": "^16.4.0",
    "next-sanity": "^13.3.4",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "resend": "^6.32.1",
    "sanity": "^6.18.0",
    "server-only": "^0.0.1",
    "stripe": "^23.0.0",
    "styled-components": "^6.5.3",
    "zod": "^4.6.5",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.64.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@tailwindcss/turbopack": "^4.3.3",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitest/coverage-v8": "^5.0.3",
    "chrome-launcher": "^1.2.2",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.0",
    "lighthouse": "^13.5.0",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vitest": "^5.0.3"
  }
}
