rules_version = '2';

// Glint & Thread private store (PRD 9.8, 10.1).
// - A signed-in customer can read and write only their own users/{uid} tree.
// - customerOrders are readable only by the owning uid and are NEVER writable from a client:
//   the server writes them with the Admin SDK (which bypasses these rules).
// - Everything else is denied.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function shortString(value, max) {
      return value is string && value.size() <= max;
    }

    function optionalString(data, key, max) {
      return !(key in data) || data[key] == null || shortString(data[key], max);
    }

    function validProfile() {
      let d = request.resource.data;
      return d.keys().hasOnly([
          'firstName', 'lastName', 'phone', 'email',
          'marketingOptIn', 'marketingConsentAt', 'marketingConsentVersion', 'marketingConsentSource', 'marketingSyncedAt',
          'createdAt'
        ])
        && optionalString(d, 'firstName', 80)
        && optionalString(d, 'lastName', 80)
        && optionalString(d, 'phone', 30)
        && optionalString(d, 'email', 254)
        && optionalString(d, 'marketingConsentAt', 40)
        && optionalString(d, 'marketingConsentVersion', 60)
        && optionalString(d, 'marketingConsentSource', 40)
        && optionalString(d, 'marketingSyncedAt', 40)
        && optionalString(d, 'createdAt', 40)
        && (!('marketingOptIn' in d) || d.marketingOptIn is bool);
    }

    function validAddress() {
      let d = request.resource.data;
      return d.keys().hasOnly(['label', 'name', 'line1', 'line2', 'city', 'province', 'postalCode', 'phone', 'isDefault', 'createdAt', 'updatedAt'])
        && d.keys().hasAll(['name', 'line1', 'city', 'province', 'postalCode'])
        && shortString(d.name, 100)
        && shortString(d.line1, 120)
        && shortString(d.city, 80)
        && shortString(d.province, 2)
        && shortString(d.postalCode, 7)
        && optionalString(d, 'label', 40)
        && optionalString(d, 'line2', 120)
        && optionalString(d, 'phone', 30)
        && optionalString(d, 'createdAt', 40)
        && optionalString(d, 'updatedAt', 40)
        && (!('isDefault' in d) || d.isDefault is bool);
    }

    function validCart() {
      let d = request.resource.data;
      return d.keys().hasOnly(['lines', 'promoCode', 'updatedAt'])
        && d.lines is list
        && d.lines.size() <= 50
        && optionalString(d, 'promoCode', 32)
        && optionalString(d, 'updatedAt', 40);
    }

    match /users/{uid} {
      allow read, delete: if isOwner(uid);
      allow create, update: if isOwner(uid) && validProfile();

      match /addresses/{addressId} {
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid) && validAddress();
      }

      match /cart/{cartId} {
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid) && validCart();
      }
    }

    match /customerOrders/{orderId} {
      allow read: if signedIn() && resource.data.uid == request.auth.uid;
      allow write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
