# Copy to .env.local. Every variable is optional: with none set, the site runs in local catalogue mode.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
DATA_SOURCE=local                     # local | sanity
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2026-10-01
SANITY_API_READ_TOKEN=
SANITY_API_WRITE_TOKEN=               # server only: seed, orders, stock
SANITY_REVALIDATE_SECRET=
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
TAX_MODE=none                         # none | stripe
RESEND_API_KEY=
RESEND_AUDIENCE_ID=                   # optional: newsletter contacts are added to this Resend audience
EMAIL_FROM="Glint & Thread <orders@example.ca>"
OWNER_EMAIL=
EMAIL_HASH_SALT=                      # long random string, server only: hashes emails on orders (PRD 9.8)
DEV_DEFAULT_STOCK=10
